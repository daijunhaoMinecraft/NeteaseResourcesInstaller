<ui:Page x:Class="NeteaseResourcesInstaller.Pages.InstallBedrockResources"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:NeteaseResourcesInstaller.Pages"
      xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
      xmlns:ikw="http://schemas.inkore.net/lib/ui/wpf"
      xmlns:models="using:NeteaseResourcesInstaller.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="800"
      d:DesignWidth="1200"
      Title="基岩版资源包安装" >
    <Grid>
        <ScrollViewer  VerticalScrollBarVisibility="Auto">
            <ikw:SimpleStackPanel Margin="55,20,20,0" Spacing="20">
                <ui:InfoBar
                            Title="注意" IsOpen="True" Severity="Warning"
                            Message="使用此软件请先将基岩版客户端重置到原来的状态(未修改的状态,除软件标记完毕之外)并且vanilla_netease文件夹不能随意修改(包括但不限于修改/删除/替换文件等),否则可能会导致材质错误,需后果自负"> 
                </ui:InfoBar>
                <ikw:SimpleStackPanel x:Name="MainResourceControl" Spacing="10">
                    <TextBlock Text="材质控制" FontSize="20" IsEnabled="False"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Row="0" Grid.Column="0" Content="导入MCPACK材质" Click="LoadNewResource_OnClick" Margin="0,0,10,0"/>
                        <Button Grid.Row="0" Grid.Column="1" Content="删除材质" Click="DeleteResource_OnClick" Margin="0,0,10,0"/>
                        <Button Grid.Row="0" Grid.Column="2" Content="材质优先级向上移动" Click="ResourceUp_OnClick" Margin="0,0,10,0"/>
                        <Button Grid.Row="0" Grid.Column="3" Content="材质优先级向下移动" Click="ResourceDown_OnClick"></Button>
                    </Grid>
                    <Border Background="#fafafa"
                            BorderBrush="#e0e0e0"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="12">
                        <ikw:SimpleStackPanel Spacing="10" Margin="0,10,0,0">
                            <TextBlock Text="材质包列表" FontSize="20"/>
                        
                            <!-- 改为 ListView -->
                            <ui:ListView x:Name="ResourcesList"
                                         Grid.Row="1"
                                         SelectionMode="Multiple"
                                         Height="400"
                                         SelectionChanged="ContentGridView_SelectionChanged">
                                <ui:ListView.ItemTemplate>
                                    <DataTemplate DataType="local:ResourceItem">
                                        <StackPanel Orientation="Horizontal" Margin="10">
                                            <Image Source="{Binding Thumbnail}" Width="128" Height="128" Stretch="UniformToFill" Margin="0,0,10,0"/>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Title}" FontWeight="Bold" Margin="0,0,0,5"/>
                                                <TextBlock Text="{Binding Description}" TextWrapping="Wrap" MaxWidth="300"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </DataTemplate>
                                </ui:ListView.ItemTemplate>
                            </ui:ListView>
                        </ikw:SimpleStackPanel>
                    </Border>
                </ikw:SimpleStackPanel>
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Button Content="安装材质" Click="InstallResource_Onclick"  Grid.Row="0" Grid.Column="0" Margin="0,0,10,0"/>
                    <Button Content="还原材质" Click="RestoreResources_OnClick" Grid.Row="0" Grid.Column="1"/>
                </Grid>
            </ikw:SimpleStackPanel>
            </ScrollViewer>
    </Grid>
</ui:Page>