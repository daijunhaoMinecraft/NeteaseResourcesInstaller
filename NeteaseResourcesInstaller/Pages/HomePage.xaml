<ui:Page x:Class="NeteaseResourcesInstaller.Pages.HomePage"
         xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
         xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
         xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
         xmlns:local="clr-namespace:NeteaseResourcesInstaller.Pages"
         xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
         d:DesignHeight="600"
         d:DesignWidth="800"
         mc:Ignorable="d"
         Title="主页">
    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="55,20,0,0">
                <Border Background="#fafafa"
                        BorderBrush="#e0e0e0"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="12"
                        Margin="0,0,20,10">
                    <Grid>
                        <StackPanel>
                            <TextBlock Text="通知" FontSize="20"/>
                            <TextBlock Margin="0,10,0,20" x:Name="Notify" Text="获取通知中..."/>
                            <Separator/>
                            <Grid Margin="0,10,0,10">
                                <ui:HyperlinkButton x:Name="Control1"
                                                    Content="Github开源项目地址"
                                                    IsEnabled="True"
                                                    NavigateUri="https://github.com/daijunhaoMinecraft/NeteaseResourcesInstaller" />
                            </Grid>
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</ui:Page>