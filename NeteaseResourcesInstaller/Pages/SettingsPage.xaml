<ui:Page x:Class="NeteaseResourcesInstaller.Pages.SettingsPage"
         xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
         xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
         xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
         xmlns:local="clr-namespace:NeteaseResourcesInstaller.Pages"
         xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
         xmlns:system="clr-namespace:System;assembly=System.Runtime"
         d:DesignHeight="800"
         d:DesignWidth="1200"
         mc:Ignorable="d"
         Title="设置">
    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <!--  These styles can be referenced to create a consistent SettingsPage layout  -->
            <FrameworkElement.Resources>
                <!--  Spacing between cards  -->
                <system:Double x:Key="SettingsCardSpacing">4</system:Double>
                <!--  Style (inc. the correct spacing) of a section header  -->
                <Style x:Key="SettingsSectionHeaderTextBlockStyle"
                       BasedOn="{StaticResource BodyStrongTextBlockStyle}"
                       TargetType="TextBlock">
                    <Style.Setters>
                        <Setter Property="Margin" Value="1,30,0,6" />
                    </Style.Setters>
                </Style>
            </FrameworkElement.Resources>
            <StackPanel Margin="55,20,20,0">
                <TextBlock Style="{StaticResource SettingsSectionHeaderTextBlockStyle}"
                           Text="基本设置" />
                <ui:SettingsExpander Description="设置你的网易我的世界基岩版路径"
                                     Header="设置基岩版路径">
                    <ComboBox x:Name="ComboBoxSelectBedrockPath"
                              ItemsSource="{Binding canSelectBedrockVersion}"
                              DisplayMemberPath="Item1"
                              SelectedValuePath="Item2" SelectionChanged="SelectBedrockPath_OnSelectionChanged"/>
                    <ui:SettingsExpander.Items>
                        <ui:SettingsCard Header="当前选择的基岩版列表路径">
                            <TextBox x:Name="TextBoxSelectBedrockPath" Text="" IsReadOnly="True"/>
                        </ui:SettingsCard>
                        <ui:SettingsCard Header="基岩版文件夹">
                            <ComboBox x:Name="ComboBoxSelectBedrockVersion"/>
                        </ui:SettingsCard>
                        <ui:SettingsCard x:Name="SettingsCardCustomBedrockPath" Header="自定义基岩版列表路径" IsEnabled="False">
                            <Button Content="选择文件夹" Click="SelectFolder_OnClick"/>
                        </ui:SettingsCard>
                    </ui:SettingsExpander.Items>
                </ui:SettingsExpander>
                <ui:SettingsCard Header="保存配置" Description="保存当前配置">
                    <Button Content="保存配置" Click="SaveConfig_Onclick"/>
                </ui:SettingsCard>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</ui:Page>